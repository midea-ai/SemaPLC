# sema-plc-web — LLM API keys
#
# Copy this file to `.env` (gitignored) and fill in the key for the model you use.
# `./dev.sh` sources `.env` automatically; `npm run dev` reads whatever is in your shell.
#
# Pick the model with PLC_MODEL (see README). The default is `deepseek`.
# You only need the key matching the model you actually run.

# DeepSeek (default, recommended) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# MiniMax — https://platform.minimaxi.com   (all MiniMax variants share this one key)
MINIMAX_API_KEY=

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini (OpenAI-compatible endpoint) — https://aistudio.google.com
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=

# xAI Grok — https://console.x.ai
XAI_API_KEY=

# Groq — https://console.groq.com
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=

# Alibaba Cloud Model Studio / DashScope / Qwen — https://bailian.console.aliyun.com
QWEN_API_KEY=

# Moonshot / Kimi — https://platform.moonshot.ai
KIMI_API_KEY=

# Z.AI / Zhipu GLM — https://z.ai
ZAI_API_KEY=

# BigModel / 智谱 GLM 官方接口 — https://open.bigmodel.cn
# BIGMODEL_MODEL=glm-5.2
BIGMODEL_API_KEY=

# SiliconFlow — https://siliconflow.cn
SILICONFLOW_API_KEY=

# Together AI — https://api.together.ai
TOGETHER_API_KEY=

# 字节豆包 / 火山方舟 — https://www.volcengine.com/product/ark
# DOUBAO_MODEL=doubao-seed-2-1-pro-260628   # 可覆盖,默认 doubao-seed-2-1-pro-260628
DOUBAO_API_KEY=

# Generic OpenAI-compatible endpoint:
# PLC_MODEL=openai-compatible   # or custom / glm-4.7 / glm-5-turbo for the same GLM relay
# PLC_OPENAI_COMPATIBLE_API_KEY=
# PLC_OPENAI_COMPATIBLE_MODEL=
# PLC_OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example/v1
# PLC_OPENAI_COMPATIBLE_PROVIDER=openai   # openai / anthropic
