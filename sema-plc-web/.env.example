# sema-plc-web — LLM API keys
#
# Copy this file to `.env` (gitignored) and fill in the key for the model you use.
# `./dev.sh` sources `.env` automatically; `npm run dev` reads whatever is in your shell.
#
# Pick the model with PLC_MODEL (see README). The default is `deepseek`.
# You only need the key matching the model you actually run.

# DeepSeek (default, recommended) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# MiniMax — https://platform.minimaxi.com   (all MiniMax variants share this one key)
MINIMAX_API_KEY=

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini (OpenAI-compatible endpoint) — https://aistudio.google.com
GEMINI_API_KEY=
