{
  "name": "plc-vis-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,VITE -c blue,green \"npm:dev:server\" \"npm:dev:vite\"",
    "dev:server": "tsx watch --ignore '**/node_modules/**' server/index.ts --workspace ${WORKSPACE:-$HOME/plc-workspace}",
    "dev:vite": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json && vite build && rm -rf dist-server/templates && cp -R templates dist-server/templates",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.39.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xyflow/react": "^12.4.0",
    "axios": "^1.7.0",
    "commander": "^12.0.0",
    "express": "^4.21.0",
    "form-data": "^4.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.0",
    "remark-gfm": "^4.0.1",
    "sema-core": "file:vendor/sema-core-2.0.5.tgz",
    "socket.io-client": "^4.7.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
