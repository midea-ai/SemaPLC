node_modules/

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Test / coverage output
coverage/
.nyc_output/

# Environment
.env
.env.local

# 运行时用户数据(服务从仓库根启动,写在 cwd)
custom-models.json
key-overrides.json

# brainstorm visual companion sessions
.superpowers/

# external reference projects / large clones — not part of this repo
related-plc-projects/
related-benchmarks/

# 本地工具 / 运行产物
.claude/
.playwright-mcp/

# 工作截图(不入库)
*.png
# 但 README logo 等需入库
!docs/images/*
# VSCode 插件图标(package.json 的 icon 字段指向它,缺了 vsce package 会失败)
!sema-plc-vscode/images/*

# 草稿 / 临时仿真文件
**/.review-design.md
**/scene_draft*.json
**/scene_*.min.json

# 本地分析产物，不纳入版本库
session-analysis/

# 临时调试抓包产物(GLM 请求/响应复现等),不入库
tmp/

# docs/ 只纳入 docsify 文档站文件与 logo 资产,其余草稿不入库
docs/*
!docs/images/
!docs/index.html
!docs/style.css
!docs/_sidebar.md
!docs/README.md
!docs/.nojekyll
!docs/wiki/
!docs/en/
