{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Structured Text",
  "scopeName": "source.st",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#literal" },
    { "include": "#address" },
    { "include": "#pou-declaration" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#standard-fb" },
    { "include": "#function-call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.st",
          "match": "//.*$"
        },
        {
          "name": "comment.block.st",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        },
        {
          "comment": "编译指示 pragma",
          "name": "meta.preprocessor.st",
          "begin": "\\{",
          "end": "\\}"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "comment": "单引号字符串(ST 标准),$ 为转义引导符",
          "name": "string.quoted.single.st",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.st", "match": "\\$(?:[0-9A-Fa-f]{2}|.)" }
          ]
        },
        {
          "comment": "双引号为宽字符串",
          "name": "string.quoted.double.st",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.st", "match": "\\$(?:[0-9A-Fa-f]{4}|.)" }
          ]
        }
      ]
    },
    "literal": {
      "patterns": [
        {
          "comment": "时间/日期字面量 T#3s TIME#100ms LTIME#1d2h D#2024-01-01 TOD#12:00:00 DT#...",
          "name": "constant.numeric.time.st",
          "match": "(?i)\\b(?:T|LT|TIME|LTIME|D|LD|DATE|LDATE|TOD|LTOD|TIME_OF_DAY|DT|LDT|DATE_AND_TIME)#[0-9a-z_:\\-\\.\\+]+"
        },
        {
          "comment": "带基数的整数 16#FF 2#1010_1010 8#777",
          "name": "constant.numeric.base.st",
          "match": "(?i)\\b(?:[0-9]+)#[0-9a-f_]+"
        },
        {
          "comment": "带类型前缀的字面量 INT#10 REAL#1.5",
          "name": "constant.numeric.typed.st",
          "match": "(?i)\\b(?:BOOL|S?INT|D?INT|LINT|U(?:S|D|L)?INT|UINT|BYTE|WORD|DWORD|LWORD|REAL|LREAL)#[0-9a-f_\\.\\+\\-]+"
        },
        {
          "name": "constant.numeric.st",
          "match": "(?i)\\b[0-9][0-9_]*(?:\\.[0-9_]+)?(?:e[\\+\\-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.st",
          "match": "(?i)\\b(?:TRUE|FALSE|NULL)\\b"
        }
      ]
    },
    "address": {
      "comment": "直接地址 %IX0.0 %QW1 %MD4 %M100",
      "name": "variable.other.address.st",
      "match": "(?i)%[IQM][XBWDL]?[0-9]+(?:\\.[0-9]+)*"
    },
    "keyword": {
      "patterns": [
        {
          "comment": "程序组织单元与声明段",
          "name": "keyword.other.pou.st",
          "match": "(?i)\\b(?:PROGRAM|END_PROGRAM|FUNCTION_BLOCK|END_FUNCTION_BLOCK|FUNCTION|END_FUNCTION|METHOD|END_METHOD|INTERFACE|END_INTERFACE|CONFIGURATION|END_CONFIGURATION|RESOURCE|END_RESOURCE|TASK|END_TASK|NAMESPACE|END_NAMESPACE|TYPE|END_TYPE|STRUCT|END_STRUCT|UNION|END_UNION|VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_TEMP|VAR_GLOBAL|VAR_EXTERNAL|VAR_ACCESS|VAR_CONFIG|VAR_INST|VAR|END_VAR)\\b"
        },
        {
          "comment": "控制流",
          "name": "keyword.control.st",
          "match": "(?i)\\b(?:IF|THEN|ELSIF|ELSE|END_IF|CASE|OF|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|EXIT|CONTINUE|RETURN|GOTO|JMP)\\b"
        },
        {
          "comment": "修饰符与其它",
          "name": "keyword.other.st",
          "match": "(?i)\\b(?:CONSTANT|RETAIN|NON_RETAIN|PERSISTENT|AT|WITH|ON|SINGLE|INTERVAL|PRIORITY|READ_ONLY|READ_WRITE|ARRAY|POINTER|REFERENCE|EXTENDS|IMPLEMENTS|PUBLIC|PRIVATE|PROTECTED|INTERNAL|OVERRIDE|ABSTRACT|FINAL|SUPER|THIS)\\b"
        }
      ]
    },
    "type": {
      "name": "storage.type.st",
      "match": "(?i)\\b(?:BOOL|BYTE|WORD|DWORD|LWORD|SINT|INT|DINT|LINT|USINT|UINT|UDINT|ULINT|REAL|LREAL|TIME|LTIME|DATE|LDATE|TIME_OF_DAY|TOD|LTOD|DATE_AND_TIME|DT|LDT|STRING|WSTRING|CHAR|WCHAR|ANY|ANY_NUM|ANY_INT|ANY_REAL|ANY_BIT|ANY_DATE|ANY_STRING|ANY_DERIVED|ANY_ELEMENTARY)\\b"
    },
    "standard-fb": {
      "patterns": [
        {
          "comment": "标准功能块(与 src/lang/st-docs.ts 词表一致)",
          "name": "support.class.fb.st",
          "match": "(?i)\\b(?:TON|TOF|TP|CTU|CTD|CTUD|R_TRIG|F_TRIG|SR|RS)\\b"
        },
        {
          "comment": "标准函数",
          "name": "support.function.st",
          "match": "(?i)\\b(?:ABS|SQRT|LN|LOG|EXP|SIN|COS|TAN|ASIN|ACOS|ATAN|ADD|SUB|MUL|DIV|MOVE|SHL|SHR|ROL|ROR|SEL|MAX|MIN|LIMIT|MUX|LEN|LEFT|RIGHT|MID|CONCAT|INSERT|DELETE|REPLACE|FIND|TRUNC|ROUND)\\b"
        }
      ]
    },
    "pou-declaration": {
      "comment": "声明处的 POU 名字。此前只有调用点(#function-call)有 scope,`PROGRAM traffic_light` 里的名字是无色的。必须排在 #keyword 之前 —— 两条规则在同一位置起匹,TextMate 取列表里靠前的那条。",
      "match": "(?i)\\b(PROGRAM|FUNCTION_BLOCK|FUNCTION|METHOD|INTERFACE|NAMESPACE|CONFIGURATION|RESOURCE)\\s+((?:(?:PUBLIC|PRIVATE|PROTECTED|INTERNAL|OVERRIDE|ABSTRACT|FINAL)\\s+)*)([a-z_][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.pou.st" },
        "2": { "name": "keyword.other.st" },
        "3": { "name": "entity.name.type.st" }
      }
    },
    "function-call": {
      "comment": "调用点的标识符",
      "match": "(?i)\\b([a-z_][a-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.st" }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.logical.st",
          "match": "(?i)\\b(?:AND|OR|XOR|NOT|MOD)\\b"
        },
        {
          "name": "keyword.operator.assignment.st",
          "match": ":=|=>"
        },
        {
          "name": "keyword.operator.comparison.st",
          "match": "<>|<=|>=|<|>|="
        },
        {
          "name": "keyword.operator.arithmetic.st",
          "match": "\\*\\*|[\\+\\-\\*/]"
        }
      ]
    }
  }
}
