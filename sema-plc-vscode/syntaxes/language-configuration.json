{
  "comments": {
    "lineComment": "//",
    "blockComment": ["(*", "*)"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(*", "close": "*)", "notIn": ["string", "comment"] },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["'", "'"],
    ["\"", "\""]
  ],
  "wordPattern": "(%[IQMiqm][XBWDLxbwdl]?[0-9]+(\\.[0-9]+)*)|([A-Za-z_][A-Za-z0-9_]*)",
  "folding": {
    "markers": {
      "comment": "真实 ST 大量不缩进 POU 体(runtime/samples/traffic_light.st 语句全在第 0 列),缺省的按缩进折叠等于没有,必须给显式标记。写法上有两个坑:(1) 必须用 IRegExp 对象形式 —— JS 正则不支持 (?i) 这种内联修饰符,new RegExp('(?i)...') 直接抛 Invalid group,而 VSCode 解析失败时是静默丢规则,不报错;(2) start/end 的 flags 必须一致,VSCode 只在相同时才把两条合并成 (start)|(?:end) 一条。",
      "start": {
        "comment": "起点必须整行收尾([^;]*$),否则 CONFIGURATION 里的 `PROGRAM inst WITH task : prog;`(实例化语句,没有 END_PROGRAM)会被当成 POU 起点,把整块折叠配对错位。同理单行的 `IF x THEN y := 1; END_IF;` 两边都不匹配,自然平衡。ELSIF 不算起点 —— 一个 IF 只有一个 END_IF,把 ELSIF 也算上会让外层 IF 配不到尾。",
        "pattern": "^\\s*(?:(?:\\w+\\s*:\\s*)?(?:STRUCT|UNION)|PROGRAM|FUNCTION_BLOCK|FUNCTION|METHOD|INTERFACE|NAMESPACE|CONFIGURATION|RESOURCE|TYPE|VAR(?:_INPUT|_OUTPUT|_IN_OUT|_TEMP|_GLOBAL|_EXTERNAL|_ACCESS|_CONFIG|_INST)?|IF\\b.*\\bTHEN|CASE\\b.*\\bOF|(?:FOR|WHILE)\\b.*\\bDO|REPEAT)\\b[^;]*$",
        "flags": "i"
      },
      "end": {
        "comment": "END_REPEAT 故意不在列 —— REPEAT 的收尾是 UNTIL,而 `UNTIL c` 与 `END_REPEAT;` 分两行写时会数出两个 end,多出来的那个会被上一层的起点抢走(VSCode 是自底向上配对,栈里多一个哨兵就错一层)。UNTIL 一条同时覆盖单行与分行两种写法。",
        "pattern": "^\\s*(?:END_(?:PROGRAM|FUNCTION_BLOCK|FUNCTION|METHOD|INTERFACE|NAMESPACE|CONFIGURATION|RESOURCE|TYPE|STRUCT|UNION|VAR|IF|CASE|FOR|WHILE)|UNTIL)\\b",
        "flags": "i"
      }
    }
  },
  "indentationRules": {
    "increaseIndentPattern": {
      "pattern": "^\\s*(?:(?:IF|ELSIF)\\b.*\\bTHEN|ELSE|CASE\\b.*\\bOF|(?:FOR|WHILE)\\b.*\\bDO|REPEAT|VAR(?:_INPUT|_OUTPUT|_IN_OUT|_TEMP|_GLOBAL|_EXTERNAL|_ACCESS|_CONFIG|_INST)?|TYPE|STRUCT|PROGRAM|FUNCTION_BLOCK|FUNCTION|METHOD|CONFIGURATION|RESOURCE)\\b.*?\\s*(?:\\(\\*.*\\*\\)|//.*)?$",
      "flags": "i"
    },
    "decreaseIndentPattern": {
      "pattern": "^\\s*(?:END_(?:IF|CASE|FOR|WHILE|REPEAT|VAR|TYPE|STRUCT|PROGRAM|FUNCTION_BLOCK|FUNCTION|METHOD|CONFIGURATION|RESOURCE)|ELSE|ELSIF|UNTIL)\\b",
      "flags": "i"
    }
  }
}
